int openStreams(char* serial)
{
  int rtn = -1;
  rtn = open(serial, O_RDWR);

  return rtn;
}

int setSerial(int fd, struct termios port, int baudRate)
{
  int rtn = 0;
  if(tcgetattr(fd, &programmer) != 0)
  {
    printf("Serial port error (%d): %s\n", errno, strerror(errno));
    rtn = -1;
  }
  else
  {
    // Control mode flags
    programmer.c_cflag &= ~PARENB;        // disable parity
    programmer.c_cflag &= ~CSTOPB;        // One stop bit
    programmer.c_cflag &= ~CSIZE;         // Clear bits per word...
    programmer.c_cflag |= CS8;            // Then set to 8
    programmer.c_cflag &= ~CRTSCTS;       // No hardware flow control
    programmer.c_cflag |= CREAD | CLOCAL; // Enable reading and set local mode
    // Local mode flags
    programmer.c_lflag &= ~ICANON;        // Disable canonical mode
    programmer.c_lflag &= ~ECHO;          // Disalbe all echos
    programmer.c_lflag &= ~ECHOE;         // including erasure
    programmer.c_lflag &= ~ECHONL;        // and newline
    programmer.c_lflag &= ~ISIG;          // Disable signal characters
    programmer.c_lflag |= (IXON | IXOFF | IXANY); // turn on software flow
    // Turn off special receive character handling
    programmer.c_lflag &= ~(IGNBRK|BRKINT|PARMRK|ISTRIP|INLCR|IGNCR|ICRNL);
    // Output mode flags
    programmer.c_oflag &= ~OPOST;         // No output byte interpretation
    programmer.c_oflag &= ~ONLCR;         // Don't convert cr/lf
    // The next two aren't defined in Linux
    //programmer.c_oflag &= ~OXTABS;        // Don't convert tabs to spaces
    //programmer.c_oflag &= ~ONOEOT;        // Don't remove EOT characters
    // Control
    programmer.c_cc[VTIME] = 0;           // Don't wait for characters
    programmer.c_cc[VMIN]  = 0;           // No timeout
    // Set baud rate
    cfsetispeed(&programmer, baudRate);   // Set input baud rate
    cfsetospeed(&programmer, baudRate);   // Set output baud rate
    // Save the settings and apply now
    if(tcsetattr(fd, TCSANOW, &programmer) != 0)
    {
      printf("Serial port error (%d): %s\n", errno, strerror(errno));
      rtn = -1;
    }
  }

  return rtn;
}
