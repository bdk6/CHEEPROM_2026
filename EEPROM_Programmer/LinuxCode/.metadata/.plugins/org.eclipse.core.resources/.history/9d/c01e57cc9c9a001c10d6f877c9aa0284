// termios struct:
//   tcflag_t c_iflag;     // input mode flags
//   tcflag_t c_oflag;     // output mode flags
//   tcflag_t c_cflag;     // control mode flags
//   tcflag_t c_lflag;     // local mode flags
//   cc_t c_line;          // line discipline
//   cc_t c_cc[NCCS];      // control characters

// c_cflag
//  PARENB                 // parity bit: 1 for parity
//  CSTOPB                 // stop bits: 1 for 2 stop, 0 for 1
//  CSIZE                  // data bits: &=~CSIZE clear all then |= ...
//                         // CS5, CS6, CS7, CS8 for 5,6,7,8 bits
//  CRTSCTS                // RTS/CTS flow: &= ~ CRTSCTS none, |= CRTSCTS on
//  CREAD                  // Enable READING!  (|= CREAD)
//  CLOCAL                 // Local mode, no modem control lines
// c_lflag
//  ICANON                 // Canonical mode: &= ~ICANON disables
//  ECHO                   // &= ~ECHO, &= ~ECHOE, &= ~ECHONL disables
//  ISIG                   // &= ~ISGIG disables signal chars
// c_iflag                 //
//  IXOFF                  // xoff processing: 1 to enable
//  IXON                   // xon processing: 1 to enable
//  IXANY                  // xoff,xon processing: 1 to enable
//  IGNBRK                 // break
//  BRKINT                 // break interrupt?
//  PARMRK                 // ??
//  ISTRIP                 // ??
//  INLCR                  // ?? Ignore NL,CR?
//  IGNCR                  // Ignore CR?
//  ICRNL                  // Ignore NL
//                         // &=~(IGNBRK|BRKINT|PARMRK|ISTRIP|INLCR|IGNCR|ICRNL)
// c_oflag                 // output flags
//  OPOST                  // output special interp: &= ~OPOST
//  ONLCR                  // prevent NL->CRNL &= ~ONLCR
//  OXTABS                 // not defined in LInux?
//  ONOEOT                 // not defined in LInux?
//  XTABS                  // ??
// c_cc                    // control characters
//  VMIN                   // # characters                 (0 to 255)
//  VTIME                  // timeout (tenths of a second) (0 to 255)
//         // VMIN=0,VTIME=0  return with whats available
//         // VMIN>0,VTIME=0  wait indefinitely for VMIN chars
//         // VMIN=0,VTIME>0  block until something comes or timeout
//         // VMIN>0,VTIME>0  block until VMIN chars or timeout
//         // tty.c_cc[VTIME] = 10;   // Wait 1 sec
//         // tty.c_cc[VMIN]  = 0;    // Any number of characters
// cfsetispeed(&tty, B9600);
// cfsetospeed(&tty, B9600);
//  set baud rate: B0, B50, B75, B110, B134, B150, B200, B300, B600, B1200,
//           B1800, B2400, B4800, B9600, B19200, B38400, B57600, B115200,
//           B230400, B460800
// cfsetspeed(&tty, B9600);   set both input and output
// With gcc, you can set any number for Bxxxx -> cfsetspeed(&tty, 12345678);

//
struct termios programmer;

int serialFD;


int openStreams(char* serial);
int setSerial(int fd, struct termios port, int baudRate);



